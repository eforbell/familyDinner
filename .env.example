# Copy to .env and fill in your values

# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
#   USER      — postgres role/username (often "postgres" on a default install)
#   PASSWORD  — that role's password (set with: \password in psql)
#   HOST      — IP or hostname of your Postgres server
#               use "localhost" if the app runs on the same machine as Postgres
#   PORT      — default is 5432 unless you changed it; local Docker Compose here uses 5436
#   DBNAME    — the database to use; create it first with:
#               createdb family_dinner   (or via psql: CREATE DATABASE family_dinner;)
#
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/family_dinner
# Local Docker Compose default: docker compose up -d db

# Port the app listens on — access it at http://<server-ip>:3000 from any LAN device
PORT=3000

# OpenAI key for Magic Meal generation
OPENAI_API_KEY=

# Optional: override the model used for Magic Meal drafts
OPENAI_MODEL=gpt-4o-mini

# Optional: reasoning effort sent with Magic requests.
# GPT-5.1+ accepts: none | low | medium | high | xhigh ('minimal' was retired)
OPENAI_REASONING_EFFORT=none

# Sovereign font delivery (default: Google CDN; optional local override)
SOVEREIGN_FONT_SOURCE=google
SOVEREIGN_FONT_SANS_CSS_URL=https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap
SOVEREIGN_FONT_MONO_CSS_URL=https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap
# Local mode URLs used when SOVEREIGN_FONT_SOURCE=local
SOVEREIGN_FONT_SANS_CSS_URL_LOCAL=https://homebase.tailnet/_sovereign/fonts/source-sans-3.css
SOVEREIGN_FONT_MONO_CSS_URL_LOCAL=https://homebase.tailnet/_sovereign/fonts/jetbrains-mono.css

