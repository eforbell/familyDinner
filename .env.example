# Copy to .env and fill in your values

# postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
#   USER      — postgres role/username (often "postgres" on a default install)
#   PASSWORD  — that role's password (set with: \password in psql)
#   HOST      — IP or hostname of your Postgres server
#               use "localhost" if the app runs on the same machine as Postgres
#   PORT      — default is 5432 unless you changed it; local Docker Compose here uses 5436
#   DBNAME    — the database to use; create it first with:
#               createdb family_dinner   (or via psql: CREATE DATABASE family_dinner;)
#
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/family_dinner
# Local Docker Compose default: docker compose up -d db

# Port the app listens on — access it at http://<server-ip>:3000 from any LAN device
PORT=3000

# OpenAI key for Magic Meal generation
OPENAI_API_KEY=

# Optional: override the model used for Magic Meal drafts
OPENAI_MODEL=gpt-4o-mini
