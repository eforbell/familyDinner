{
  "name": "family-dinner",
  "version": "1.0.0",
  "description": "Family dinner app — what's for dinner tonight?",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "sh -c 'set -a; [ -f ./.env ] && . ./.env; set +a; psql \"$DATABASE_URL\" -f db/seed.sql'",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  }
}
