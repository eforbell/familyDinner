[Unit]
Description=Family Dinner App
After=network.target postgresql.service

[Service]
Type=simple
User=your-username
WorkingDirectory=/data/apps/familyDinner
EnvironmentFile=/data/apps/familyDinner/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /data/apps/familyDinner/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
