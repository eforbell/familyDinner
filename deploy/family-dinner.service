[Unit]
Description=Forbell Family Dinner App
After=network.target postgresql.service

[Service]
Type=simple
User=forbell
WorkingDirectory=/home/forbell/familyDinner
EnvironmentFile=/home/forbell/familyDinner/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/forbell/familyDinner/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
